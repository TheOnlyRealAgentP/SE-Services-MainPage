source "https://rubygems.org"

# Matches the versions GitHub Pages uses to build the live site.
# GitHub's own build ignores this file; it only matters for local previews.
gem "github-pages", group: :jekyll_plugins

# Needed to run `jekyll serve` on Ruby 3.0+ (no longer bundled with Ruby).
gem "webrick", "~> 1.8"

# Standard-library gems that newer Ruby versions no longer load by default.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
gem "faraday-retry"
